PORT=5020
ADMIN_TOKEN=xypht-admin
# Optional GitHub sync (same pattern as Noft-Website)
# IMPORTANT: Do NOT put production GITHUB_TOKEN in local .env while testing.
# A local/stale orders.json + production token can overwrite live history.
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GITHUB_BRANCH=main
# GITHUB_IMAGES_PATH=frontend/public/uploads
# GITHUB_PRODUCTS_PATH=backend/products.json
# GITHUB_SALE_PATH=backend/sale.json
# GITHUB_ORDERS_PATH=backend/orders.json
# GITHUB_EXPENSES_PATH=backend/expenses.json
